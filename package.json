{
  "name": "ninjalauncher",
  "version": "2.0.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "icons:macos": "swift scripts/generate-platform-icons.swift --macos-only && bash scripts/compile-macos-icon.sh",
    "icons:windows": "CLANG_MODULE_CACHE_PATH=${TMPDIR:-/tmp}/ninja-launcher-clang-cache swift scripts/generate-platform-icons.swift --windows-only && bash scripts/compile-windows-icon.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "skinview3d": "^3.4.2",
    "three": "^0.156.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
