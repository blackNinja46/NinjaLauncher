{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ninja Launcher",
  "version": "2.0.0",
  "identifier": "live.blackninja",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ninja Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/macos/compiled/Assets.car",
        "Resources/NinjaLauncher.icns": "icons/macos/compiled/NinjaLauncher.icns"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDZEQTQ4QkFFNjM4RTcxMDMKUldRRGNZNWpyb3VrYlpmQjNRcGNOMjhQa1UrMUNEdmlSNDdGR1pGU2IrOWlONjluTEhvaE0vVWEK",
      "endpoints": [
        "https://github.com/blackNinja46/NinjaLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
